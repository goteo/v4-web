{
  "name": "goteo",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "build:testing": "CLOUDFLARE_ENV=testing astro build --mode testing",
    "build:staging": "CLOUDFLARE_ENV=staging astro build --mode staging",
    "build:prod": "CLOUDFLARE_ENV=prod astro build --mode prod",
    "deploy:testing": "pnpm build:testing && pnpm wrangler --env testing d1 migrations apply goteov4web-db-testing --remote && wrangler deploy --env testing",
    "deploy:staging": "pnpm build:staging && pnpm wrangler --env staging d1 migrations apply goteov4web-db-staging --remote && wrangler deploy --env staging",
    "deploy:prod": "pnpm build:prod && pnpm wrangler --env prod d1 migrations apply goteov4web-db-prod --remote && wrangler deploy --env prod",
    "check": "pnpm check:format:prettier",
    "check:astro": "astro check",
    "check:format:prettier": "prettier --check . --plugin prettier-plugin-astro --plugin prettier-plugin-svelte",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:types": "pnpm check:astro && pnpm check:svelte",
    "db:migrate": "wrangler d1 migrations apply goteov4web-db --local",
    "db:seed": "wrangler d1 execute goteov4web-db --local --file=./db/seed.sql",
    "dev": "astro dev",
    "format": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint --fix . && prettier --write .",
    "format:eslint": "eslint --fix . ",
    "format:prettier": "prettier --write .",
    "openapi": "openapi-ts",
    "preview": "astro preview",
    "preview:ci": "NODE_ENV=test NODE_TLS_REJECT_UNAUTHORIZED=0 SKIP_PAYMENT_GATEWAYS=true PAYMENT_GATEWAYS_ENABLED=false wrangler dev --env preview --port 4321 --ip 0.0.0.0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "14.2.6",
    "@astrojs/node": "^11.1.5",
    "@astrojs/svelte": "^9.0.1",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@internationalized/date": "^3.12.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/static-renderer": "3.28.0",
    "@types/iso-3166-2": "^1.0.4",
    "astro": "7.2.10",
    "bits-ui": "^2.18.1",
    "chart.js": "^4.5.1",
    "csrf": "^3.1.0",
    "dexie": "^4.4.2",
    "dinero.js": "^2.0.2",
    "dotenv": "^17.4.2",
    "file-type": "^22.0.1",
    "flickity": "^3.0.0",
    "iso-3166-2": "^1.0.0",
    "marked": "^18.0.6",
    "media-icons": "^1.1.5",
    "murmurhash-js": "^1.0.0",
    "stdnum": "^1.12.6",
    "svelte": "^5.56.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/svelte-vite": "^10.5.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/murmurhash-js": "^1.0.7",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^10.5.2",
    "eslint-plugin-svelte": "^3.22.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "flowbite": "^3.1.2",
    "flowbite-svelte": "1.5.2",
    "flowbite-svelte-icons": "^2.3.0",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "start-server-and-test": "^3.0.11",
    "storybook": "^10.5.2",
    "svelte-check": "^4.7.4",
    "svelte-eslint-parser": "^1.8.0",
    "svelte-range-slider-pips": "^4.1.1",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10",
    "wrangler": "^4.127.1"
  }
}
