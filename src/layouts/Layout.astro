---
import { Font } from "astro:assets";

import "../styles/global.css";
import Metatags from "./Metatags.astro";

import type { FontPreloadFilter } from "astro:assets";

const { title, description, keywords } = Astro.props;

/**
 * Only the upright latin face is worth preloading — it is the one every page needs before
 * first paint. Italic and latin-ext are declared all the same, and the browser fetches them
 * when a glyph on the page actually calls for them.
 */
const preloadedFaces: FontPreloadFilter = [{ style: "normal", subset: "latin" }];
---

<!doctype html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
        <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
        <title>{title}</title>
        <Font cssVariable="--font-karla" preload={preloadedFaces} />
        <Metatags {title} {description} {keywords} />
    </head>
    <body class="bg-white">
        <slot />
        <script is:inline>
            /**
             * Seeds --header-height from the server-rendered header before first paint.
             * The ResizeObserver in Header.svelte only runs once the island hydrates, so
             * without this the var stays at its 0px fallback and <main> jumps down by the
             * header height on hydration (CLS ~0.11 on the home page).
             */
            const header = document.getElementById("header-measure");

            if (header) {
                document.documentElement.style.setProperty(
                    "--header-height",
                    `${header.getBoundingClientRect().bottom}px`,
                );
            }
        </script>
    </body>
</html>
