---
import CampaignTabsCarousel from "./CampaignTabsCarousel.svelte";
import type { Campaign } from "../../types/campaign";
import {
    apiAccountingsIdGet,
    apiProjectsIdOrSlugGet,
    type Money,
    type Project,
} from "../../openapi/client";
import { getLanguage } from "../../middleware/utils";
import { extractId } from "../../utils/extractId";
import { proposedCampaignsRepository } from "../../repositories/proposedCampaigns";

import type { ProposedCampaignTab } from "../../repositories/proposedCampaigns";

const { t } = Astro.locals;

const data = await proposedCampaignsRepository.get();

const slots = (data?.slots ?? []).sort((a, b) => a.position - b.position);

if (slots.length === 0) {
    return;
}

const resolved = (
    await Promise.all(
        slots.map(async (slot) => {
            const { data: project } = await apiProjectsIdOrSlugGet({
                path: { idOrSlug: String(slot.projectId) },
                headers: { "Accept-Language": getLanguage(Astro) },
            });

            if (!project) return null;

            return { slot, project };
        }),
    )
).filter((r): r is { slot: (typeof slots)[number]; project: Project } => r !== null);

const campaignsByTab: Partial<Record<ProposedCampaignTab, Campaign[]>> = {};

await Promise.all(
    resolved.map(async ({ slot, project }) => {
        const { data: accounting } = await apiAccountingsIdGet({
            path: { id: extractId(project.accounting)! },
        });

        const campaign = {
            ...project,
            size: "small" as const,
            slug: project.slug!,
            title: project.title!,
            image: project.video?.thumbnail! || project.cover!,
            minimum: project.budget?.minimum?.money!,
            obtained: accounting!.balance as Money,
            optimum: project.budget?.optimum?.money,
        } satisfies Campaign;

        (campaignsByTab[slot.tab] ??= []).push(campaign);
    }),
);
---

<section class="wrapper flex flex-col gap-6">
    <!-- Header Section -->
    <div class="flex items-center justify-start">
        <h2 class="text-2xl font-bold text-black">{t("pages.home.campaigns.tabsTitle")}</h2>
    </div>

    <!-- Tabs + Campaigns Carousel (one set of campaigns per tab) -->
    <CampaignTabsCarousel client:visible {campaignsByTab} />
</section>
