---
import ResourceCard from "./ResourceCard.astro";
import Arrow from "../../components/icons/navigation/Arrow.svelte";
import { namesForIds } from "../../services/taxonomy";
import { excerptFromMarkdown } from "../../utils/blog";
import Grid from "../library/layout/Grid.svelte";

import type { Category, Theme } from "../../openapi/client";
import type { BlogPostRecord } from "../../repositories/blogPosts";

interface Props {
    posts: BlogPostRecord[];
    categories?: Category[];
    themes?: Theme[];
}

const { posts, categories = [], themes = [] } = Astro.props;
const { t, lang } = Astro.locals;

const resources = posts.map((post) => ({
    id: post.id,
    title: post.title,
    description: post.subtitle || excerptFromMarkdown(post.content),
    image: post.headerMedia.find((media) => media.type.startsWith("image/"))?.url,
    href: `/${lang}/blog/${post.id}`,
    linkText: t("pages.home.resources.readMore"),
    tags: [...namesForIds(categories, post.categoryIds), ...namesForIds(themes, post.themeIds)],
}));
---

<section class="wrapper py-16">
    <div class="flex flex-col gap-6">
        <!-- Header with title and view all button -->
        <div
            class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center md:gap-0"
        >
            <h2
                class="text-xl leading-7 font-bold text-black md:text-2xl md:leading-8 lg:text-4xl lg:leading-12"
            >
                {t("pages.home.resources.title")}
            </h2>
            <a
                href={`/${lang}/blog?section=resources`}
                class="bg-variant1 text-secondary hover:bg-secondary flex items-center gap-2 rounded-3xl px-4 py-3 text-sm leading-5 font-bold transition-all duration-200 hover:text-white md:px-6 md:py-4 md:text-base md:leading-6"
            >
                <Arrow />
                <span>{t("pages.home.resources.viewAll")}</span>
            </a>
        </div>

        <!-- Resources cards grid -->
        <Grid class="grid-cols-1 gap-6 lg:grid-cols-2">
            {
                resources.map((resource) => (
                    <ResourceCard
                        title={resource.title}
                        description={resource.description}
                        image={resource.image}
                        href={resource.href}
                        linkText={resource.linkText}
                        tags={resource.tags}
                    />
                ))
            }
        </Grid>
    </div>
</section>
