---
// Latest blog post on the homepage
import type { BlogPostRecord } from "../../repositories/blogPosts";

interface Props {
    post: BlogPostRecord;
}

const { post } = Astro.props;
const { t, lang } = Astro.locals;

const cover = post.headerMedia.find((media) => media.type.startsWith("image/"));
---

<section class="wrapper">
    <!-- Blog Entry Container -->
    <div class="bg-variant1 flex flex-col rounded-4xl lg:flex-row lg:items-stretch">
        <!-- Content Section (Left) -->
        <div class="flex flex-col gap-6 p-10 lg:min-h-0 lg:flex-1">
            <!-- Main Content -->
            <div class="flex flex-col gap-2">
                <h2 class="text-secondary text-4xl leading-12 font-bold">
                    {post.title}
                </h2>
                {post.subtitle && <p class="text-secondary text-base leading-6">{post.subtitle}</p>}
            </div>

            <!-- Button -->
            <div class="flex">
                <a
                    href={`/${lang}/blog/${post.id}`}
                    class="group border-secondary hover:bg-secondary flex items-center justify-center gap-2 rounded-3xl border px-6 py-4 transition-all duration-200"
                >
                    <span class="text-secondary text-base font-bold group-hover:text-white">
                        {t("pages.home.blog.readMore")}
                    </span>
                </a>
            </div>
        </div>

        <!-- Right Side - Blog Image (background so height follows left content) -->
        {
            cover && (
                <div class="relative hidden overflow-hidden rounded-r-4xl lg:block lg:flex-1">
                    <div
                        role="img"
                        aria-label={post.title}
                        class="h-full w-full bg-cover bg-center"
                        style={{ backgroundImage: `url(${JSON.stringify(cover.url)})` }}
                    />
                </div>
            )
        }
    </div>
</section>
