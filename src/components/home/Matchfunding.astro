---
// Matchfunding section derived from Figma design
// Uses design tokens and Tailwind utility classes.
// The call cards and impact metrics that used to live here were hardcoded Goteo deployment
// data: real call titles, invented figures, bundled images and Spanish-only strings. Power
// them from apiMatchCalls* and point the buttons at real routes before re-enabling this
// section on the home page.
const { t } = Astro.locals;
---

<section class="bg-secondary w-full text-white">
    <div class="wrapper relative !my-[-32px]">
        <!-- Two top info panels -->
        <div class="flex flex-col gap-6">
            <div class="flex flex-col gap-6 lg:flex-row lg:justify-between">
                <!-- What is Matchfunding -->
                <div
                    class="backdrop-blur-md/0 flex flex-col gap-10 rounded-2xl bg-[rgba(143,124,146,0.4)] p-10 lg:w-1/2"
                >
                    <div class="text-purple-soft flex flex-col gap-4 text-balance">
                        <h2 class="text-purple-soft text-4xl font-bold">
                            {t("pages.home.matchfunding.title")}
                        </h2>
                        <p class="text-base leading-6 text-white">
                            {t("pages.home.matchfunding.description")}
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href="/matchfunding"
                            class="group relative flex items-center gap-2 rounded-3xl border border-white/40 bg-white/20 px-6 py-4 text-sm font-bold text-white backdrop-blur-md transition hover:bg-white/30"
                        >
                            {t("pages.home.matchfunding.actions.learnMore")}
                        </a>
                        <a
                            href="/convocatorias"
                            class="bg-purple-soft text-secondary rounded-3xl px-6 py-4 text-sm font-bold transition hover:opacity-90"
                        >
                            {t("pages.home.matchfunding.actions.viewCalls")}
                        </a>
                    </div>
                </div>
                <!-- Impact data -->
                <div
                    class="backdrop-blur-md/0 flex flex-col gap-10 rounded-2xl bg-[rgba(143,124,146,0.4)] p-10 lg:w-1/2"
                >
                    <div class="text-purple-soft flex flex-col gap-4">
                        <h3 class="text-purple-soft text-4xl font-bold">
                            {t("pages.home.matchfunding.impact.title")}
                        </h3>
                        <p class="text-base leading-6 text-white">
                            {t("pages.home.matchfunding.impact.description")}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
