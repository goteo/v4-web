---
export interface Props {
    title: string;
    description: string;
    image?: string;
    href?: string;
    linkText?: string;
    tags?: string[];
}

const {
    title,
    description,
    image = undefined,
    href = "#",
    linkText = "Leer más",
    tags = [],
} = Astro.props;
---

<article class="border-grey h-full rounded-3xl border bg-white p-6 shadow-sm">
    <div class="flex h-full flex-col gap-6 md:flex-row">
        <!-- Image -->
        <div class="shrink-0">
            {
                image ? (
                    <img
                        src={image}
                        alt=""
                        class="h-48 w-full rounded-2xl object-cover md:h-56 md:w-56"
                        loading="lazy"
                    />
                ) : (
                    <div class="bg-purple-soft h-48 w-full rounded-2xl md:h-56 md:w-56" />
                )
            }
        </div>

        <!-- Content -->
        <div class="flex flex-1 flex-col gap-6 md:h-56">
            <!-- Text content -->
            <div class="flex flex-1 flex-col gap-2">
                <h3
                    class="text-secondary line-clamp-2 text-xl leading-7 font-bold md:text-2xl md:leading-8"
                >
                    {title}
                </h3>
                <p
                    class="text-content line-clamp-3 text-sm leading-5 md:line-clamp-4 md:text-base md:leading-6"
                >
                    {description}
                </p>
            </div>

            <!-- Link and tags -->
            <div class="flex shrink-0 items-center justify-between gap-4">
                <a
                    href={href}
                    class="text-secondary text-sm leading-5 font-bold underline underline-offset-2 transition-opacity hover:opacity-80 md:text-base md:leading-6"
                >
                    {linkText}
                </a>
                {
                    tags.length > 0 && (
                        <div class="flex flex-wrap justify-end gap-2">
                            {tags.map((tag) => (
                                <span class="bg-variant1 text-secondary rounded-sm px-2 py-1 text-xs font-bold">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    )
                }
            </div>
        </div>
    </div>
</article>
