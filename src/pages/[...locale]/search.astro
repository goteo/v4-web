---
import Layout from "../../layouts/Layout.astro";
import App from "../../layouts/App.svelte";
import Search from "../../components/search/Search.svelte";
import { parseSearchParamsFilters } from "../../utils/searchParams";

const { t, lang } = Astro.locals;

const initialFilters = parseSearchParamsFilters(new URL(Astro.request.url).searchParams);
---

<Layout title={t("pages.search.title")} description={t("pages.search.description")}>
    <App client:load locale={lang}>
        <section class="wrapper">
            <!-- Page Header -->
            <div class="mb-12 text-center">
                <h1 class="text-secondary mb-4 text-4xl font-bold">
                    {t("pages.search.heading")}
                </h1>
                <p class="text-secondary text-lg">
                    {t("pages.search.subtitle")}
                </p>
            </div>

            <Search initialFilters={initialFilters} client:load />
        </section>
    </App>
</Layout>
