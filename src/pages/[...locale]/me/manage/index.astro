---
import Layout from "../../../../layouts/Layout.astro";
import App from "../../../../layouts/App.svelte";
import WithSidebar from "../../../../layouts/WithSidebar.svelte";
import { goto } from "../../../../utils/navigation";

const { lang, t, session } = Astro.locals;

if (!session) {
    return goto("/login", { query: { callback: "/me/manage" } });
}

const activePath = "/me/manage";
---

<Layout title={t("pages.me.manage.title")}>
    <App client:load locale={lang} session={session}>
        <WithSidebar client:idle navItems={[]} {activePath}>
            <div class="text-content font-body text-base leading-6"></div>
        </WithSidebar>
    </App>
</Layout>
