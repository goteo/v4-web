---
import Layout from "../../../../layouts/Layout.astro";
import App from "../../../../layouts/App.svelte";
import WithSidebar from "../../../../layouts/WithSidebar.svelte";
import Highlights from "../../../../components/admin/home/Highlights.svelte";
import { apiProjectsIdOrSlugGet } from "../../../../openapi/client/sdk.gen";
import { highlightRepository } from "../../../../repositories/highlights";
import { SUBSECTIONS } from "./subsections";

const { t, lang, session } = Astro.locals;
const activePath = "/admin/home/highlights";

const data = await highlightRepository.get();

const config = {
    highlight: data
        ? {
              type: data.highlight.type,
              layout: data.highlight.layout,
          }
        : null,
    slots: await Promise.all(
        (data?.slots ?? []).map(async (s) => {
            const { data: project } = await apiProjectsIdOrSlugGet({
                path: { idOrSlug: String(s.projectId) },
                headers: { "Accept-Language": lang },
            });

            return {
                position: s.position,
                projectId: s.projectId,
                projectTitle: project?.title ?? String(s.projectId),
                projectImage: project?.video?.thumbnail ?? project?.cover ?? null,
            };
        }),
    ),
};
---

<Layout
    title={t("pages.admin.home.highlights.title")}
    description={t("pages.metadata.description")}
>
    <App client:load locale={lang} session={session} admin>
        <WithSidebar client:idle navItems={SUBSECTIONS} {activePath}>
            <Highlights client:load {config} />
        </WithSidebar>
    </App>
</Layout>
