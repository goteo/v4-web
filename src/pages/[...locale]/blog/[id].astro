---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import BlogPost from "../../../components/blog/BlogPost.svelte";
import { blogPostRepository } from "../../../repositories/blogPosts";
import { getTaxonomy, namesForIds } from "../../../services/taxonomy";
import { textsIn } from "../../../utils/blog";

const { lang, langs } = Astro.locals;

const id = Number(Astro.params.id);
const post = Number.isInteger(id) && id > 0 ? await blogPostRepository.getById(id) : null;

if (!post?.published) {
    return Astro.rewrite("/404");
}

const texts = textsIn(post, lang);
const { categories, themes } = await getTaxonomy(langs);
const tags = [...namesForIds(categories, post.categoryIds), ...namesForIds(themes, post.themeIds)];
---

<Layout title={texts.title} description={texts.subtitle ?? undefined}>
    <App headerLogo={Astro.locals.headerLogo} client:load locale={lang}>
        <BlogPost post={post} {tags} client:load />
    </App>
</Layout>
