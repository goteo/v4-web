---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import ReturnHeader from "../../../components/library/buttons/ReturnHeader.svelte";
import BodyText from "../../../components/library/typography/BodyText.svelte";

const { t, lang } = Astro.locals;
const { fileName } = Astro.params;

const markdownFiles = import.meta.glob<{ default: any }>("../../../../static/*md");

const fileKey = Object.keys(markdownFiles).find((path) => path.endsWith(`${fileName}.md`));

if (!fileKey) {
    return Astro.rewrite("/404");
}

const file = await markdownFiles[fileKey]();

const Content = file.default;
---

<Layout title={t("pages.static.title")} description={t("pages.metadata.description")}>
    <App client:load locale={lang}>
        <ReturnHeader client:idle />

        <BodyText>
            <Content />
        </BodyText>
    </App>
</Layout>
