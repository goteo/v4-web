---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import VerificationError from "./_VerificationError.astro";
import VerificationSuccess from "./_VerificationSuccess.astro";

import {
    apiAccountingsIdGet,
    apiGatewayCheckoutsIdGet,
    apiGatewaysGetCollection,
    apiProjectSupportsGetCollection,
    apiProjectsGetCollection,
} from "../../../openapi/client";
import { apiProjectsIdOrSlugGetUrl } from "../../../openapi/client/operation-paths.gen";
import { client } from "../../../openapi/client/client.gen";

import { extractId } from "../../../utils/extractId";
import { sumMoney } from "../../../utils/money";
import { goto } from "../../../utils/navigation";

import type {
    GatewayCharge,
    Money,
    MoneyOutput,
    Project,
    ProjectSupport,
} from "../../../openapi/client";

const { t, lang, session } = Astro.locals;

if (!session) {
    return goto("/login", {
        query: {
            callback: Astro.url.pathname + Astro.url.search,
        },
    });
}

const { token, user } = session;
const checkoutId = Astro.url.searchParams.get("checkoutId");

const postPaymentUrl = checkoutId
    ? `/checkout/post-payment?checkoutId=${checkoutId}`
    : "/checkout/post-payment";

const [{ data: paymentGateways }, { data: accounting }] = await Promise.all([
    apiGatewaysGetCollection(),
    apiAccountingsIdGet({
        path: { id: extractId(user.accounting)! },
        headers: token.asHttpHeaders,
    }),
]);

let error: string | undefined;
let total: Money | undefined;
let selectedGateway: string | undefined;
let donatedProjects: Project[] = [];
let projectSupports: ProjectSupport[] = [];
let charges: GatewayCharge[] = [];

try {
    if (!checkoutId) {
        throw new Error("Checkout ID not found");
    }

    const { data: checkout } = await apiGatewayCheckoutsIdGet({
        path: { id: checkoutId },
        headers: token.asHttpHeaders,
    });

    if (!checkout) {
        throw new Error("Checkout data not found");
    }

    if (checkout.status !== "charged") {
        throw new Error("Payment not completed");
    }

    selectedGateway = checkout.gateway.split("/").at(-1);

    charges = checkout.charges ?? [];

    const money = charges
        .map((charge) => charge.money)
        .filter((money): money is MoneyOutput => Boolean(money));

    total = money.length > 0 ? sumMoney(money) : undefined;

    const accountingTargets = [
        ...new Set(
            charges
                .map((charge) => charge.target)
                .filter((target): target is string => Boolean(target)),
        ),
    ];

    const { data: projects = [] } = await apiProjectsGetCollection({
        query: {
            "accounting[]": accountingTargets,
        },
    });

    donatedProjects = projects;

    if (projects.length > 0) {
        const projectUrls = projects.map((project) =>
            client.buildUrl({
                url: apiProjectsIdOrSlugGetUrl,
                path: { idOrSlug: project.id },
            }),
        );

        const { data: supports = [] } = await apiProjectSupportsGetCollection({
            query: {
                origin: user.accounting,
                "project[]": projectUrls,
            },
            headers: token.asHttpHeaders,
        });

        projectSupports = supports;
    }
} catch (err) {
    console.error("Error trying to verify payment", err);

    error = err instanceof Error ? err.message : "Unknown error";
}
---

<Layout title={t("pages.checkout.verify.title")}>
    <App client:load locale={lang} session={session}>
        <div class="wrapper pt-6 md:px-0">
            {
                error ? (
                    <VerificationError
                        accounting={accounting}
                        paymentGateways={paymentGateways}
                        selectedGateway={selectedGateway}
                        postPaymentUrl={postPaymentUrl}
                    />
                ) : (
                    <VerificationSuccess
                        total={total}
                        selectedGateway={selectedGateway}
                        donatedProjects={donatedProjects}
                        projectSupports={projectSupports}
                        postPaymentUrl={postPaymentUrl}
                        {checkoutId}
                    />
                )
            }
        </div>
    </App>
</Layout>
