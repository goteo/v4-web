---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import ShippingAddresses from "../../../components/checkout/ShippingAddresses.svelte";
import ShippingContinue from "../../../components/checkout/ShippingContinue.svelte";
import Steps from "../../../components/checkout/Steps.svelte";
import Summary from "../../../components/checkout/Summary.svelte";
import BackButton from "../../../components/library/buttons/BackButton.svelte";
import Card from "../../../components/library/cards/Card.svelte";
import { apiAddressesGetCollection } from "../../../openapi/client";
import { client } from "../../../openapi/client/client.gen";
import { apiUsersIdOrHandleGetUrl } from "../../../openapi/client/operation-paths.gen";
import { toCollectionItems } from "../../../utils/hydra";

const { t, lang, session } = Astro.locals;

if (!session) {
    return Astro.redirect("/checkout/login?callback=/checkout/shipping");
}

const userIri = client.buildUrl({
    url: apiUsersIdOrHandleGetUrl,
    path: { idOrHandle: String(session.user.id) },
});

const { data: addresses } = await apiAddressesGetCollection({
    query: { user: userIri, itemsPerPage: 100 },
    headers: session.token.asHttpHeaders,
});
---

<Layout
    title={t("pages.checkout.metadata.title")}
    description={t("pages.checkout.metadata.description")}
>
    <App client:load locale={lang} session={session} class="mb-20">
        <div class="wrapper max-md:px-0">
            <BackButton client:idle />
            <div class="flex flex-col gap-8 pt-6 lg:flex-row">
                <div class="flex w-full flex-col gap-10 px-4 lg:w-1/2 lg:px-0">
                    <div class="flex flex-col gap-4">
                        <h2 class="text-[2.5rem]/12 font-bold tracking-[0%] text-black">
                            {t("pages.checkout.shipping.title")}
                        </h2>
                        <p class="text-content">{t("pages.checkout.shipping.description")}</p>
                    </div>

                    <ShippingAddresses
                        client:load
                        addresses={toCollectionItems(addresses)}
                        {userIri}
                    />
                </div>

                <Card
                    class="lg: sticky -bottom-6 flex h-fit w-full flex-col items-start gap-6 rounded-3xl border-black pr-4 pb-10 pl-4 lg:top-(--sticky-top) lg:bottom-auto lg:w-1/2 lg:gap-6 lg:rounded-[40px] lg:p-6"
                >
                    <Summary client:load />
                    <div class="w-full lg:block" id="checkout-details">
                        <div class="w-full">
                            <Steps step={3} hasError={false} client:idle />
                        </div>
                        <div class="flex flex-col">
                            <p class="text-content text-sm">{t("pages.checkout.summary.deduct")}</p>
                        </div>
                    </div>
                    <ShippingContinue client:load />
                </Card>
            </div>
        </div>
    </App>
</Layout>
