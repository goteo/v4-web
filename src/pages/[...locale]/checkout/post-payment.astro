---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import Carousel from "../../../components/library/layout/Carousel.svelte";
import CampaignCard from "../../../components/home/CampaignCard.svelte";
import {
    apiProjectsGetCollection,
    apiGatewayCheckoutsIdGet,
    apiAccountingsIdGet,
    apiProjectsIdOrSlugGet,
} from "../../../openapi/client";
import type { Money, Project } from "../../../openapi/client";
import { extractId } from "../../../utils/extractId";
import { getDefaultCurrency } from "../../../utils/consts";
import type { Campaign } from "../../../types/campaign";

const { t, lang, session } = Astro.locals;

// These cards render statically, so they never run CampaignCard's client-side balance fallback.
const mapProjectToCard = (project: Project, obtained?: Money) =>
    ({
        id: project.slug || "",
        slug: project.slug || "",
        title: project.title || "",
        subtitle: project.subtitle || "",
        description: project.description || "",
        image: project.video?.thumbnail || "/images/placeholder-project.jpg",
        obtained: obtained || { amount: 0, currency: getDefaultCurrency() },
        minimum: project.budget?.minimum?.money || { amount: 0, currency: getDefaultCurrency() },
        categories: project.categories || [],
        territory: project.territory || "",
        size: "small",
    }) as unknown as Campaign;

/** Reads a project's raised amount from its Accounting balance. */
const fetchBalance = async (accountingIri?: string): Promise<Money | undefined> => {
    const id = extractId(accountingIri);
    if (!id) return undefined;

    try {
        const { data } = await apiAccountingsIdGet({ path: { id } });
        return data?.balance as Money | undefined;
    } catch (error) {
        console.error("Error fetching accounting balance:", error);
        return undefined;
    }
};

let donatedProjects: Campaign[] = [];
let suggestedProjects: Campaign[] = [];
let userEmail = "";

const checkoutId = Astro.url.searchParams.get("checkoutId");

if (session && checkoutId) {
    try {
        const { token, user } = session;
        const authHeaders = token.asHttpHeaders;

        if (user?.email) {
            userEmail = user.email;
        }

        const { data: checkout } = await apiGatewayCheckoutsIdGet({
            path: { id: checkoutId },
            headers: authHeaders,
        });

        if (checkout?.charges) {
            // Several charges can target the same accounting (one per reward), so dedupe the targets.
            const targetAccountingUrls = [
                ...new Set(checkout.charges.map((charge: any) => charge.target).filter(Boolean)),
            ] as string[];

            const projectPromises = targetAccountingUrls.map(async (accountingUrl: string) => {
                try {
                    const accountingId = extractId(accountingUrl);
                    if (!accountingId) return null;

                    const { data: accounting } = await apiAccountingsIdGet({
                        path: { id: accountingId },
                        headers: authHeaders,
                    });

                    if (!accounting) return null;

                    // Skips non-project recipients, such as the tipjar.
                    if (!accounting.owner?.includes("/v4/projects/")) return null;

                    const projectId = extractId(accounting.owner);

                    // This is the project's own accounting, so its balance is the raised amount.
                    return projectId
                        ? { projectId, obtained: accounting.balance as Money | undefined }
                        : null;
                } catch (error) {
                    console.error("Error fetching accounting or extracting project ID:", error);
                    return null;
                }
            });

            const targets = (await Promise.all(projectPromises)).filter((t) => t !== null);

            const projectDataPromises = targets.map(async ({ projectId, obtained }) => {
                try {
                    const { data: project } = await apiProjectsIdOrSlugGet({
                        path: { idOrSlug: projectId },
                        headers: authHeaders,
                    });

                    return project ? mapProjectToCard(project, obtained) : null;
                } catch (error) {
                    console.error("Error fetching project data:", error);
                    return null;
                }
            });

            donatedProjects = (await Promise.all(projectDataPromises)).filter(
                Boolean,
            ) as Campaign[];
        }
    } catch (error) {
        console.error("Error loading donated projects:", error);
        donatedProjects = [];
    }
}

try {
    const { data: projects } = await apiProjectsGetCollection({
        query: {
            status: "in_campaign",
            itemsPerPage: 20,
        },
    });

    if (projects) {
        suggestedProjects = await Promise.all(
            projects.map(async (project) =>
                mapProjectToCard(project, await fetchBalance(project.accounting)),
            ),
        );
    }
} catch (error) {
    console.error("Error loading suggested projects:", error);
    suggestedProjects = [];
}
---

<!-- GOTEO-OC-DONATION-CERTIFICATE: meta description is a placeholder; replace with a neutral
     post-payment copy (it previously reused the removed certificate copy). -->
<Layout
    title={t("pages.checkout.postPayment.title")}
    description={t("pages.checkout.postPayment.title")}
>
    <App client:load locale={lang} session={session}>
        <section class="wrapper flex flex-col items-start gap-6 pb-16 md:gap-10 md:pb-20">
            <div class="flex w-full items-start self-stretch">
                <div class="flex flex-1 flex-col items-start gap-4 self-stretch">
                    <h2
                        class="self-stretch text-2xl leading-8 font-bold text-black md:text-3xl md:leading-10 lg:text-[2.5rem] lg:leading-12"
                    >
                        {t("pages.checkout.postPayment.title")}
                    </h2>
                    <p
                        class="text-content font-feature-settings-['case'_on] self-stretch text-sm leading-6 font-normal ordinal md:text-base"
                    >
                        {t("pages.checkout.postPayment.emailSent")}
                        {userEmail}
                    </p>
                </div>
            </div>

            <div class="flex w-full flex-col items-start gap-12 pb-20 md:gap-18">
                <!-- GOTEO-OC-DONATION-CERTIFICATE: certificate info card, exclusive to the donation-certificate
                 feature of Goteo under Fundación Platoniq, hidden in the open-core. Re-enable with the
                 feature toggle when it exists. Do not delete.
                <div
                    class="flex flex-col items-start gap-6 self-stretch rounded-4xl bg-white md:flex-row md:items-center md:gap-10"
                >
                    <div class="h-16 w-16 shrink-0 md:h-20 md:w-20">
                        <img
                            src="/images/checkout/post-payment.svg"
                            alt="Post payment"
                            class="h-full w-full object-contain"
                        />
                    </div>

                    <div class="flex flex-1 flex-col items-start gap-4 md:gap-6">
                        <h2
                            class="text-secondary lg:text-double self-stretch text-xl leading-7 font-bold md:text-2xl md:leading-9 lg:leading-10"
                        >
                            {t("pages.checkout.postPayment.certificate.title")}
                        </h2>
                        <p
                            class="text-secondary font-feature-settings-['case'_on] text-base leading-6 font-normal ordinal"
                        >
                            {t("pages.checkout.postPayment.certificate.description")}
                        </p>
                    </div>
                </div>
            -->

                {
                    donatedProjects.length > 0 && (
                        <div class="flex w-full flex-col items-start gap-4 self-stretch md:gap-6">
                            <p class="text-lg leading-7 font-bold text-black md:text-xl md:leading-8 lg:text-2xl lg:leading-8">
                                {t("pages.checkout.postPayment.donatedProjects.title")} (
                                {donatedProjects.length})
                            </p>
                            <Carousel
                                client:visible
                                itemsPerGroup={1}
                                mobileItemsToShow={1}
                                desktopItemsToShow={3}
                                gap={24}
                                showDots={true}
                                class="w-full"
                            >
                                {donatedProjects.map((project) => (
                                    <CampaignCard size="small" campaign={project} />
                                ))}
                            </Carousel>
                        </div>
                    )
                }

                <div class="flex w-full flex-col items-start gap-4 self-stretch md:gap-6">
                    <p
                        class="text-lg leading-7 font-bold text-black md:text-xl md:leading-8 lg:text-2xl lg:leading-8"
                    >
                        {t("pages.checkout.postPayment.suggestedProjects.title")}
                    </p>
                    {
                        suggestedProjects.length > 0 ? (
                            <Carousel
                                client:visible
                                itemsPerGroup={1}
                                mobileItemsToShow={1}
                                desktopItemsToShow={3}
                                gap={24}
                                showDots={true}
                                class="w-full"
                            >
                                {suggestedProjects.map((project) => (
                                    <CampaignCard size="small" campaign={project} />
                                ))}
                            </Carousel>
                        ) : (
                            <p class="text-content text-base">
                                {t("pages.checkout.postPayment.suggestedProjects.empty")}
                            </p>
                        )
                    }
                </div>
            </div>
        </section>
    </App>
</Layout>
