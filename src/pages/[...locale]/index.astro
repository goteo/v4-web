---
import Layout from "../../layouts/Layout.astro";
import App from "../../layouts/App.svelte";
import Hero from "../../components/hero/Hero.svelte";
import Campaigns from "../../components/home/Campaigns.astro";
import CampaignsTabs from "../../components/home/CampaignsTabs.astro";
import Stats from "../../components/home/Stats.astro";
import FeaturedPromoters from "../../components/home/FeaturedPromoters.astro";
import Blog from "../../components/home/Blog.astro";
import Matchfunding from "../../components/home/Matchfunding.astro";
import Banners from "../../components/home/HomeBanners.svelte";
// Disabled sections, re-enable the import along with the component below:
// import Stories from "../../components/home/Stories.svelte";
// import Resources from "../../components/home/Resources.astro";
import { isSupportedLocale } from "../../i18n/locales";
import { bannerRepository } from "../../repositories/banners";
import { homeHeroRepository } from "../../repositories/homeHero";
import { renderMarkdown } from "../../utils/renderMarkdown";

const { locale } = Astro.params;

if (locale && !isSupportedLocale(locale)) {
    return Astro.rewrite("/404");
}

const { t, lang } = Astro.locals;

const activeBanners = await bannerRepository.getActive();
const hero = await homeHeroRepository.getActive();
// Authored in the admin as Markdown. Only ROLE_ADMIN can write it.
const heroContent = hero ? await renderMarkdown(hero.content) : null;
---

<Layout title={t("pages.index.title")} description={t("pages.metadata.description")}>
    <App client:load locale={lang} class="mb-20 gap-18">
        <Hero {hero} content={heroContent} />
        <Banners banners={activeBanners} client:visible />
        <Campaigns />
        <Blog />
        <Stats />
        <CampaignsTabs />
        <Matchfunding />
        <!-- Uncomment the matching import at the top when enabling either of these. -->
        <!-- <Stories client:load /> -->
        <FeaturedPromoters />
        <!-- <Resources /> -->
    </App>
</Layout>
